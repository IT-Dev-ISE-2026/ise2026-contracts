{
  "name": "ise2026-contracts",
  "version": "1.23.0",
  "main": "index.js",
  "scripts": {
    "bundle": "redocly bundle src/openapi.yaml -o dist/openapi.yaml",
    "dev": "nodemon --ext yaml --watch src --exec \"pnpm run bundle\"",
    "validate": "pnpm run bundle && pnpm exec orval --config orval.config.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist:all": "cp dist/openapi.yaml ../ise2026-fe/contracts/openapi.yaml && cp dist/openapi.yaml ../ise2026-be/contracts/openapi.yaml && cp dist/openapi.yaml ../ise2026-qa/contracts/openapi.yaml",
    "dist:fe": "cp dist/openapi.yaml ../ise2026-fe/contracts/openapi.yaml",
    "dist:be": "cp dist/openapi.yaml ../ise2026-be/contracts/openapi.yaml",
    "dist:qa": "cp dist/openapi.yaml ../ise2026-qa/contracts/openapi.yaml",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-Dev-ISE-2026/ise2026-contracts.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IT-Dev-ISE-2026/ise2026-contracts/issues"
  },
  "homepage": "https://github.com/IT-Dev-ISE-2026/ise2026-contracts#readme",
  "description": "",
  "devDependencies": {
    "@redocly/cli": "^2.20.3",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "orval": "^8.8.1",
    "typescript": "^6.0.3"
  }
}
